rules_version = '2';

// 只存使用者資料；景點目錄在 Hosting 的靜態 JSON，不在 Firestore。
// 完整資料模型見 UX-FLOW.md §3、PLAN.md §4.3。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isString(v, max) {
      return v is string && v.size() <= max;
    }

    function isDate(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // 行程與旅行紀錄（web/src/stores/trips.ts）：共編，members 裡的人都能讀寫（UX-FLOW.md C7）
    function validTrip(d) {
      return d.keys().hasOnly(['name', 'status', 'start_date', 'end_date', 'days', 'unscheduled',
                               'owner', 'members', 'member_info', 'invite', 'created_at', 'updated_at'])
        && d.status in ['planning', 'ongoing', 'done']
        && d.days is list && d.days.size() <= 60
        && d.unscheduled is list && d.unscheduled.size() <= 300
        && (!('name' in d) || isString(d.name, 80))
        && (!('start_date' in d) || isDate(d.start_date))
        && (!('end_date' in d) || isDate(d.end_date))
        && d.owner is string
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 20
        && d.owner in d.members
        && d.member_info is map
        && (!('invite' in d) || isString(d.invite, 64));
    }

    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && validTrip(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn()
        && validTrip(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && (
          // 成員：改內容（成員名單不變）；自己離開（建立者不能離開）；建立者移除其他成員
          (request.auth.uid in resource.data.members && (
            request.resource.data.members == resource.data.members
            || (request.auth.uid != resource.data.owner
                && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
            || (request.auth.uid == resource.data.owner
                && resource.data.members.hasAll(request.resource.data.members))
          ))
          // 用邀請連結加入：只能把自己加進名單；邀請碼寫在自己這次新增的 member_info.{uid}.via，
          // 必須對應到這個行程（不能沿用文件裡別人留下的值）
          || (!(request.auth.uid in resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'member_info', 'updated_at'])
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.resource.data.member_info.diff(resource.data.member_info).addedKeys().hasOnly([request.auth.uid])
            && request.resource.data.member_info.diff(resource.data.member_info).affectedKeys().hasOnly([request.auth.uid])
            && isString(request.resource.data.member_info[request.auth.uid].via, 64)
            && get(/databases/$(database)/documents/invites/$(request.resource.data.member_info[request.auth.uid].via)).data.trip_id == tripId)
        );
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    // 邀請連結：知道邀請碼的人（登入後）可以讀，不能列出；成員可以建立、刪除
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.size() >= 16 && code.size() <= 64
        && request.resource.data.keys().hasOnly(['trip_id', 'trip_name', 'inviter', 'created_by', 'created_at'])
        && request.resource.data.created_by == request.auth.uid
        && isString(request.resource.data.trip_id, 64)
        && isString(request.resource.data.trip_name, 80)
        && isString(request.resource.data.inviter, 80)
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(request.resource.data.trip_id)).data.members;
      allow delete: if signedIn()
        && (resource.data.created_by == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.members);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['display_name', 'home_airport', 'created_at', 'updated_at'])
        && (!('display_name' in request.resource.data) || isString(request.resource.data.display_name, 80))
        && (!('home_airport' in request.resource.data) || request.resource.data.home_airport in ['TPE', 'TSA', 'RMQ', 'KHH', 'TNN']);
      allow delete: if isOwner(uid);

      // 舊的行程位置：登入時搬到最上層的 trips/（只剩讀取與刪除）。
      // 練習進度仍放在這裡，每個成員各自一份。
      match /trips/{tripId} {
        allow read, delete: if isOwner(uid);

        // 旅前準備的練習進度（Leitner box 1–5）
        match /progress/{itemId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && itemId.size() <= 120
            && request.resource.data.keys().hasOnly(['box', 'updated_at'])
            && request.resource.data.box is int
            && request.resource.data.box >= 1 && request.resource.data.box <= 5;
        }
      }

      match /places/{placeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isString(request.resource.data.name, 120)
          && request.resource.data.location.lat is number
          && request.resource.data.location.lng is number
          && isString(request.resource.data.prefecture, 20);
      }

      // 經縣值（web/src/stores/keiken.ts）：各縣 0–5 級
      match /meta/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId == 'keiken'
          && request.resource.data.keys().hasOnly(['levels', 'updated_at'])
          && request.resource.data.levels is map
          && request.resource.data.levels.size() <= 47
          && request.resource.data.updated_at is timestamp;
      }

      // 收藏、去過、所屬清單（web/src/stores/marks.ts）
      match /marks/{spotId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && spotId.size() <= 40
          && request.resource.data.keys().hasOnly(['pref', 'name', 'favorite', 'visited', 'visited_on', 'lists', 'updated_at'])
          && isString(request.resource.data.pref, 20)
          && isString(request.resource.data.name, 120)
          && (!('favorite' in request.resource.data) || request.resource.data.favorite is bool)
          && (!('visited' in request.resource.data) || request.resource.data.visited is bool)
          && (!('visited_on' in request.resource.data) || request.resource.data.visited_on.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && (!('lists' in request.resource.data) || (request.resource.data.lists is list && request.resource.data.lists.size() <= 50))
          && request.resource.data.updated_at is timestamp;
      }

      match /lists/{listId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'created_at', 'updated_at'])
          && isString(request.resource.data.name, 80)
          && request.resource.data.name.size() > 0;
      }

      // 截圖收藏（web/src/stores/finds.ts）：文字欄位＋縮圖；原圖在 find_images（同 id）
      match /finds/{findId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['brand', 'item', 'note', 'thumb', 'w', 'h', 'trip_id', 'created_at', 'updated_at'])
          && isString(request.resource.data.brand, 40)
          && isString(request.resource.data.item, 80)
          && isString(request.resource.data.note, 500)
          && isString(request.resource.data.thumb, 200000)
          && request.resource.data.w is int && request.resource.data.w > 0
          && request.resource.data.h is int && request.resource.data.h > 0
          && (!('trip_id' in request.resource.data) || isString(request.resource.data.trip_id, 64))
          && request.resource.data.created_at is timestamp
          && request.resource.data.updated_at is timestamp;
      }

      match /find_images/{findId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['data', 'created_at'])
          && isString(request.resource.data.data, 1000000)
          && request.resource.data.created_at is timestamp;
      }
    }

    // 其餘路徑一律拒絕。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
