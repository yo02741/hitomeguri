rules_version = '2';

// 只存使用者資料；景點目錄在 Hosting 的靜態 JSON，不在 Firestore。
// 完整資料模型見 UX-FLOW.md §3、PLAN.md §4.3。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isString(v, max) {
      return v is string && v.size() <= max;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['display_name', 'home_airport', 'created_at', 'updated_at'])
        && (!('display_name' in request.resource.data) || isString(request.resource.data.display_name, 80))
        && (!('home_airport' in request.resource.data) || request.resource.data.home_airport in ['TPE', 'TSA', 'RMQ', 'KHH', 'TNN']);
      allow delete: if isOwner(uid);

      function isDate(v) {
        return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }

      // 行程與旅行紀錄（web/src/stores/trips.ts）
      match /trips/{tripId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'status', 'start_date', 'end_date', 'days', 'unscheduled', 'created_at', 'updated_at'])
          && request.resource.data.status in ['planning', 'ongoing', 'done']
          && request.resource.data.days is list
          && request.resource.data.days.size() <= 60
          && request.resource.data.unscheduled is list
          && request.resource.data.unscheduled.size() <= 300
          && (!('name' in request.resource.data) || isString(request.resource.data.name, 80))
          && (!('start_date' in request.resource.data) || isDate(request.resource.data.start_date))
          && (!('end_date' in request.resource.data) || isDate(request.resource.data.end_date));

        // 旅前準備的練習進度（Leitner box 1–5）
        match /progress/{itemId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && itemId.size() <= 120
            && request.resource.data.keys().hasOnly(['box', 'updated_at'])
            && request.resource.data.box is int
            && request.resource.data.box >= 1 && request.resource.data.box <= 5;
        }
      }

      match /places/{placeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isString(request.resource.data.name, 120)
          && request.resource.data.location.lat is number
          && request.resource.data.location.lng is number
          && isString(request.resource.data.prefecture, 20);
      }

      // 收藏、去過、所屬清單（web/src/stores/marks.ts）
      match /marks/{spotId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && spotId.size() <= 40
          && request.resource.data.keys().hasOnly(['pref', 'name', 'favorite', 'visited', 'visited_on', 'lists', 'updated_at'])
          && isString(request.resource.data.pref, 20)
          && isString(request.resource.data.name, 120)
          && (!('favorite' in request.resource.data) || request.resource.data.favorite is bool)
          && (!('visited' in request.resource.data) || request.resource.data.visited is bool)
          && (!('visited_on' in request.resource.data) || request.resource.data.visited_on.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && (!('lists' in request.resource.data) || (request.resource.data.lists is list && request.resource.data.lists.size() <= 50))
          && request.resource.data.updated_at is timestamp;
      }

      match /lists/{listId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'created_at', 'updated_at'])
          && isString(request.resource.data.name, 80)
          && request.resource.data.name.size() > 0;
      }
    }

    // 其餘路徑一律拒絕。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
