{
  "name": "hitomeguri",
  "private": true,
  "description": "ひとめぐり（一巡り／HITOMEGURI）：日本景點主題地圖與旅前準備",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "emulators": "firebase emulators:start --project demo-hitomeguri --only auth,firestore",
