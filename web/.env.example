# Firebase Web 設定（Firebase Console → 專案設定 → 一般 → 你的應用程式）。
# 這些值是公開的 client 設定，不是祕密；但本機仍用 .env.local 保存，不進 git。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hitomeguri-7d87a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hitomeguri-7d87a
VITE_FIREBASE_APP_ID=

# 設為 1 時前端連本機 Firebase Emulator（Auth 9099、Firestore 8080）。
# `npm run dev` 時預設為 1；`npm run build` 時一律不連 emulator。
VITE_USE_EMULATORS=1
