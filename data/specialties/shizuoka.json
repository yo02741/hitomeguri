[
  {
    "id": "shizuoka-Q106702187",
    "name": {
      "ja": "染飯",
      "kana": "せとのそめいい",
      "romaji": "Setonosomeii",
      "zh_tw": "染飯",
      "en": "Seto dyed rice"
    },
    "prefecture": "shizuoka",
    "category": "kyodo",
    "summary": {
      "text": "瀬戸の染飯（せとのそめいい）とは、現在の静岡県藤枝市上青島である駿河国志太郡青島村付近で戦国時代から販売された黄色い米飯食品である。東海道藤枝の名物であり、文化庁の日本遺産『日本初「旅ブーム」を起こした弥次さん喜多さん、駿州の旅』の「構成文化財」に認定された。",
      "lang": "ja",
      "source_url": "https://ja.wikipedia.org/wiki/%E7%80%AC%E6%88%B8%E3%81%AE%E6%9F%93%E9%A3%AF",
      "license": "CC BY-SA 4.0",
      "fetched_at": "2026-09-28"
    },
    "source_type": "kyodo_ryori",
