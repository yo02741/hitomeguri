  {
    "id": "kanagawa-Q1735816",
    "name": {
      "ja": "かて飯",
      "kana": "かてめし",
      "romaji": "Katemeshi",
      "zh_tw": "かて飯",
      "en": "katemeshi"
    },
    "prefecture": "kanagawa",
    "category": "kyodo",
    "summary": {
      "text": "Katemeshi, also spelled katé-meshi, was a common peasant food in Japan during the Meiji and Taishō periods (1867–1924). Some laborers and farmers subsisted on the dish during this time, whereas wealthier people consumed larger quantities of rice, which was a relatively expensive food compared to the income of some workers. Typical ingredients in the dish included rice, barley, millet, and chopped daikon (a mild winter radish). Variations of the dish were based upon the regional and seasonal availability of foods in different areas of Japan.",
      "lang": "en",
      "source_url": "https://en.wikipedia.org/wiki/Katemeshi",
      "license": "CC BY-SA 4.0",
      "fetched_at": "2026-09-29"
    },
