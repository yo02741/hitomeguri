  {
    "id": "kanagawa-Q1735816",
    "name": {
      "ja": "かて飯",
      "kana": "かてめし",
      "romaji": "Katemeshi",
      "zh_tw": "かて飯",
      "en": "katemeshi"
    },
    "prefecture": "kanagawa",
    "category": "kyodo",
    "summary": {
      "text": "Katemeshi, or loaded rice, is a local dish of Sagamihara City that has been passed down over many years. It is a kitchen-sink meal made by mixing together white rice and broth-simmered vegetables.At one time, much of Sagamihara’s soil was covered in volcanic ash and sterile. Rather than rice, sweet potato and wheat were widely cultivated. Katemeshi is a dish that adds vegetables like radish and potato to rice in order to make the most of that precious ingredient.",
      "lang": "en",
      "source_url": "https://www.maff.go.jp/e/policies/market/k_ryouri/search_menu/2547/index.html",
