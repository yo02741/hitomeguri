  {
    "id": "kanagawa-maff-35_13_kanagawa",
    "name": {
      "ja": "マグロのかぶと焼き",
      "kana": "まぐろのかぶとやき",
      "romaji": "Maguronokabutoyaki",
      "zh_tw": "マグロのかぶと焼き",
      "en": "Maguro no Kabutoyaki (Grilled head of tuna)"
    },
    "prefecture": "kanagawa",
    "category": "kyodo",
    "summary": {
      "text": "The Miura peninsula's Misaki Harbor is known as the preeminent harbor for tuna fishing in Japan. Grilled head of tuna is a local delicacy in Misaki: a hearty dish where, as the name suggests, an entire tuna head is grilled as-is. It originally arose from the fishermen of Misaki when they boarded their boats and set out for the open sea. They would suspend tuna heads that they could not sell at market from their ships' funnels, grilling it in covered pans before eating it.",
      "lang": "en",
      "source_url": "https://www.maff.go.jp/e/policies/market/k_ryouri/search_menu/3570/index.html",
      "license": "出典：農林水產省（公共データ利用規約 第1.0版）",
