  {
    "id": "gifu-Q11669310",
    "name": {
      "ja": "高山ラーメン",
      "kana": "たかやまらーめん",
      "romaji": "Takayama Ramen",
      "zh_tw": "高山らーめん",
      "en": "Takayama ramen"
    },
    "prefecture": "gifu",
    "category": "ramen",
    "summary": {
      "text": "高山拉麵是岐阜縣高山市流行的一種拉麵，屬於醬油拉麵派系。因當地處於飛驒地方，有時也被稱為飛驒拉麵或者飛驒高山拉麵。動畫電影《你的名字。》的主角食用過這種拉麵，電影上映後，高山拉麵的人氣大漲。目前，這種拉麵在中國、加拿大一些拉麵店也有售賣。",
      "lang": "zh",
      "source_url": "https://zh.wikipedia.org/wiki/%E9%AB%98%E5%B1%B1%E6%8B%89%E9%9D%A2",
      "license": "CC BY-SA 4.0",
